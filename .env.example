# ---- FalkorDB ----
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPH_NAME=tracelens
# Seed the demo graph automatically on startup when it is empty (needed on FalkorDB Cloud Free, which can reset).
AUTO_SEED=true

# ---- LLM (OPTIONAL — everything works without it, in deterministic mode) ----
# Any OpenAI-compatible endpoint. Free tiers only. Never commit real keys.
# Default: Groq free tier (https://console.groq.com) — model IDs from https://console.groq.com/docs/models (verified 2026-10-17).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=20
# Backup: Gemini free tier via OpenAI-compatible endpoint — verify base URL + model names in Google's docs.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# Offline: Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
