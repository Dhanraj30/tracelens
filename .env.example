# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- FalkorDB ----
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPH_NAME=tracelens
# Seed the demo graph automatically on startup when it is empty (needed on FalkorDB Cloud Free, which can reset).
AUTO_SEED=true

# ---- LLM (OPTIONAL — everything works without it, in deterministic mode) ----
# Any OpenAI-compatible endpoint. Free tiers only.
# Default: Groq free tier (https://console.groq.com). Check which models YOUR key can use:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
# (verified 2026-10-17: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b were available; llama-3.3-70b-versatile returned model_not_found)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=20
# Optional FALLBACK provider, tried automatically when the primary fails (then the deterministic template).
# Example: Gemini free tier via its OpenAI-compatible endpoint (gemini-3.5-flash-lite verified 2026-10-17; light model = fewer tokens).
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# Offline: Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
